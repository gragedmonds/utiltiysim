{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utilsim.local/schemas/development-service-notice-1.schema.json",
  "title": "Filtered development service notice",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environmentId", "premiseId", "effectiveDate", "noticeType", "services", "sourceEventId"],
  "properties": {
    "schemaVersion": {"const": "development-service-notice/1"},
    "environmentId": {"type": "string", "minLength": 1},
    "premiseId": {"type": "string", "minLength": 1},
    "effectiveDate": {"type": "string", "format": "date"},
    "noticeType": {"enum": ["utility-ready", "occupied"]},
    "sourceEventId": {"type": "string", "minLength": 1},
    "services": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["assetId", "installationId", "servicePointId", "commodity", "commissionedDate"],
        "properties": {
          "assetId": {"type": "string", "minLength": 1},
          "installationId": {"type": "string", "minLength": 1},
          "servicePointId": {"type": "string", "pattern": "^SP-[a-f0-9]{24}$"},
          "commodity": {"enum": ["electric", "gas", "water"]},
          "commissionedDate": {"type": "string", "format": "date"}
        }
      }
    }
  }
}

{
  "components": {
    "schemas": {
      "Command": {
        "properties": {
          "at": {
            "description": "Seconds since local midnight of the run day.",
            "minimum": 0.0,
            "title": "At",
            "type": "number"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "type": {
            "description": "break_asset | dispatch",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "at",
          "type"
        ],
        "title": "Command",
        "type": "object"
      },
      "FrameRequest": {
        "properties": {
          "at": {
            "description": "Seconds since local midnight of the run day.",
            "minimum": 0.0,
            "title": "At",
            "type": "number"
          },
          "commands": {
            "items": {
              "$ref": "#/components/schemas/Command"
            },
            "maxItems": 500,
            "title": "Commands",
            "type": "array"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Run day (local); default: the town's scenario date.",
            "title": "Date"
          },
          "premises": {
            "default": true,
            "title": "Premises",
            "type": "boolean"
          },
          "settings": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Overrides for response timings (see GET /api/sim/settings).",
            "title": "Settings"
          },
          "town": {
            "description": "Pack preset (e.g. 'ayr') or town id.",
            "title": "Town",
            "type": "string"
          }
        },
        "required": [
          "town",
          "at"
        ],
        "title": "FrameRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "TimelineRequest": {
        "properties": {
          "commands": {
            "items": {
              "$ref": "#/components/schemas/Command"
            },
            "maxItems": 500,
            "title": "Commands",
            "type": "array"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Run day (local); default: the town's scenario date.",
            "title": "Date"
          },
          "settings": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Overrides for response timings (see GET /api/sim/settings).",
            "title": "Settings"
          },
          "town": {
            "description": "Pack preset (e.g. 'ayr') or town id.",
            "title": "Town",
            "type": "string"
          }
        },
        "required": [
          "town"
        ],
        "title": "TimelineRequest",
        "type": "object"
      },
      "TownRequest": {
        "properties": {
          "config": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "A complete SimConfig (wins over preset/overrides).",
            "title": "Config"
          },
          "houses": {
            "anyOf": [
              {
                "maximum": 10000.0,
                "minimum": 20.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Houses"
          },
          "overrides": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Deep-merged SimConfig overrides.",
            "title": "Overrides"
          },
          "preset": {
            "default": "whitby_small",
            "description": "Base preset.",
            "title": "Preset",
            "type": "string"
          },
          "scenario": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario"
          },
          "seed": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Master seed override.",
            "title": "Seed"
          }
        },
        "title": "TownRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },

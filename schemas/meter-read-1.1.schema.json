{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:utilsim:meter-read-1.1",
  "title": "Meter read (meter-read/1.1)",
  "description": "One register observation for one read period. Register values are cumulative and never negative; import and export are separate registers. A missing observation has registerValue, consumption and readAt null (never zero) and keeps scheduledReadAt. truth is test-oracle data: strip it before sending reads to a VEE engine. Times are UTC ISO-8601; periods are [periodStart, periodEnd).",
  "type": "object",
  "required": ["id", "schemaVersion", "simulationId", "premiseId", "servicePointId", "installationId", "meterId",
               "registerId", "contractId", "accountId", "idempotencyKey", "commodity", "direction", "unit",
               "periodStart", "periodEnd", "scheduledReadAt", "readAt", "previousRegisterValue", "registerValue",
               "consumption", "multiplier", "registerDigits", "readType", "readStatus", "source", "veeStatus",
               "billingDocumentId", "invoiceId"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": "meter-read/1.1"},
    "simulationId": {"type": "string", "minLength": 1, "description": "Town id that scopes every record id."},
    "premiseId": {"type": "string", "minLength": 1},
    "servicePointId": {"type": "string", "minLength": 1},
    "installationId": {"type": "string", "minLength": 1},
    "meterId": {"type": "string", "minLength": 1},
    "registerId": {"type": "string", "minLength": 1},
    "contractId": {"type": "string", "minLength": 1, "description": "Contract active at periodStart."},
    "accountId": {"type": "string", "minLength": 1},
    "idempotencyKey": {"type": "string", "minLength": 1},
    "commodity": {"enum": ["electric", "water", "gas"]},
    "direction": {"enum": ["import", "export"]},
    "unit": {"enum": ["kWh", "m3"]},
    "periodStart": {"type": "string", "format": "date-time"},
    "periodEnd": {"type": "string", "format": "date-time"},
    "scheduledReadAt": {"type": "string", "format": "date-time"},
    "readAt": {"type": ["string", "null"], "format": "date-time"},
    "previousReadAt": {"type": ["string", "null"], "format": "date-time"},
    "previousRegisterValue": {"type": "number", "minimum": 0},
    "registerValue": {"type": ["number", "null"], "minimum": 0},
    "consumption": {"type": ["number", "null"], "minimum": 0},
    "multiplier": {"type": "number", "exclusiveMinimum": 0},
    "registerDigits": {"type": "integer", "minimum": 1, "description": "Rollover at 10^registerDigits."},
    "rolloverFlag": {"type": "boolean"},
    "readType": {"enum": ["actual", "missing", "estimated", "adjusted"]},
    "readStatus": {"type": "string", "description": "received | missing | estimated | rejected (see docs/DATA_MODEL.md)."},
    "readReason": {"type": "string", "description": "periodic | move_in | move_out | device_install | device_removal | interim"},
    "source": {"type": "string"},
    "mruId": {"type": "string"},
    "reasonCode": {"type": ["string", "null"]},
    "consecutiveEstimates": {"type": "integer", "minimum": 0},
    "occupied": {"type": "boolean"},
    "moveInAt": {"type": ["string", "null"], "format": "date-time"},
    "moveOutAt": {"type": ["string", "null"], "format": "date-time"},
    "sapValidationCode": {"type": ["string", "null"], "description": "Null means not supplied, never a pass."},
    "veeStatus": {"type": "string"},
    "billingDocumentId": {"type": ["string", "null"]},
    "invoiceId": {"type": ["string", "null"]},
    "fixtureVariant": {"enum": ["actual", "stuck", "missing", "spike"]},
    "truth": {
      "type": "object",
      "required": ["registerValue", "consumption"],
      "properties": {"registerValue": {"type": "number"}, "consumption": {"type": "number"}}
    }
  },
  "additionalProperties": true
}
